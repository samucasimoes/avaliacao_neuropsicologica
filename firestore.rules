rules_version = '2';

// Regras do Firestore: cole no console do Firebase (Firestore Database > Regras > Publicar).
// Só quem entrou com e-mail e senha lê e grava. Os acessos são criados em
// Authentication > Usuários; não existe cadastro pela tela de login.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada avaliação fica 30 dias depois da última alteração. Só pode ser apagada
    // depois desse prazo (o sistema apaga sozinho ao entrar).
    match /avaliacoes/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.atualizadoEm < request.time - duration.value(30, 'd');
    }

    // Nome de quem entrou (saudação). Cada uma só grava o próprio.
    match /profissionais/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
